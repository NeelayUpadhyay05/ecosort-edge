# Python caches and test/tooling state
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Private working notes; public project documentation belongs in the root
.project-notes/

# Generated planning/report artifacts kept locally for reference
ECOSORT_EDGE_BUILD_PLAN.html
artifact.json

# Local environments (the project will use Conda, created only after approval)
.venv/
venv/
env/

# Dataset contents: keep personal/raw/generated data out of Git history.
# Versioned manifests and documentation can still be added explicitly.
data/raw/**
data/processed/**
data/external/**
data/negative/**

# Model checkpoints and exported binaries
*.pt
*.pth
*.ckpt
*.onnx
*.engine
*.safetensors

# Training, evaluation, and generated output directories
runs/
weights/
models/
outputs/
reports/generated/

# Local notebooks and their transient checkpoints
.ipynb_checkpoints/

# Local/editor/OS files
.DS_Store
.idea/
.vscode/
